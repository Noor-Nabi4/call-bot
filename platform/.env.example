# Platform API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/call_bot
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
PLATFORM_API_HOST=0.0.0.0
PLATFORM_API_PORT=8000

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# SIP host from LiveKit project settings (without sip: prefix)
LIVEKIT_SIP_HOST=your-project.sip.livekit.cloud
AGENT_NAME=voice-agent

# Platform Twilio master account (Path B purchases + subaccounts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Security
CREDENTIALS_ENCRYPTION_KEY=
METADATA_HMAC_SECRET=
INTERNAL_SERVICE_TOKEN=
REQUIRE_CALL_SCOPE=false

# Outbox worker
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_RETRIES=8
OUTBOX_BASE_BACKOFF_SECONDS=5
OUTBOX_MAX_BACKOFF_SECONDS=900
OUTBOX_POLL_INTERVAL_SECONDS=2
OUTBOX_LEASE_SECONDS=120

# Async job / saga worker
JOB_BATCH_SIZE=10
JOB_MAX_ATTEMPTS=8
JOB_BASE_BACKOFF_SECONDS=5
JOB_MAX_BACKOFF_SECONDS=900
JOB_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=180
JOB_SHUTDOWN_TIMEOUT_SECONDS=30

# Object storage (recordings)
OBJECT_STORAGE_BACKEND=filesystem
OBJECT_STORAGE_ROOT=./data/object-storage
OBJECT_STORAGE_MAX_UPLOAD_BYTES=52428800
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
RECORDING_RETENTION_DAYS=30
# S3 / R2 / MinIO (when OBJECT_STORAGE_BACKEND=s3|r2|minio)
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

HEALTH_DB_TIMEOUT_SECONDS=2

SESSION_SECRET=dev-session-secret-change-me
OPS_CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
ENVIRONMENT=development
COOKIE_SECURE=false

# Platform SaaS Stripe account (subscriptions). Do NOT use Stripe Connect keys here.
# Plans are defined in code — no STRIPE_PRICE_* / Dashboard Products required.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:3002/settings/billing?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:3002/signup?canceled=1
STRIPE_PORTAL_RETURN_URL=http://localhost:3002/settings/billing

# Optional: allow browser fallback tenant when no SIP (dev only)
ALLOW_ENV_TENANT_FALLBACK=true

# Internal voice COGS estimates (USD) — not customer billing
COGS_OPENAI_PER_MINUTE_USD=0.0676
COGS_OPENAI_SENSITIVITY_LOW_USD=0.05
COGS_OPENAI_SENSITIVITY_HIGH_USD=0.10
COGS_OPENAI_AUDIO_INPUT_PER_1M_USD=32.0
COGS_OPENAI_AUDIO_CACHED_INPUT_PER_1M_USD=0.40
COGS_OPENAI_AUDIO_OUTPUT_PER_1M_USD=64.0
COGS_OPENAI_TEXT_INPUT_PER_1M_USD=4.0
COGS_OPENAI_TEXT_CACHED_INPUT_PER_1M_USD=0.40
COGS_OPENAI_TEXT_OUTPUT_PER_1M_USD=16.0
COGS_LIVEKIT_AGENT_PER_MINUTE_USD=0.01
COGS_LIVEKIT_AGENT_INCLUDED_MINUTES_MONTHLY=0
COGS_LIVEKIT_PLAN=ship
COGS_LIVEKIT_SIP_SHIP_PER_MINUTE_USD=0.004
COGS_LIVEKIT_SIP_SCALE_PER_MINUTE_USD=0.003
COGS_LIVEKIT_BVC_TELEPHONY_PER_MINUTE_USD=0.0012
COGS_LIVEKIT_BVC_PER_MINUTE_USD=0.0
COGS_TWILIO_US_LOCAL_ORIGINATION_PER_MINUTE_USD=0.0034
COGS_TWILIO_TERMINATION_PER_MINUTE_USD=0.01
# Omit or leave empty to use call billable_seconds for warm outbound estimate
# COGS_WARM_TRANSFER_TERMINATION_SECONDS=
COGS_LIVEKIT_FIXED_MONTHLY_USD=0.0
COGS_PHONE_RENTAL_MONTHLY_USD=0.0
COGS_SMS_MONTHLY_USD=0.0

# Production host secrets: copy .env.production.example or run deploy/install.sh
# Web: https://callandflow.com (www redirects)
# API: https://api.callandflow.com
