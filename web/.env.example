NEXT_PUBLIC_SITE_URL=http://localhost:3002
NEXT_PUBLIC_PLATFORM_API_URL=http://localhost:8000

# Required for the embedded marketing voice demo (/api/token)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=voice-agent
# Must match voice-agent METADATA_HMAC_SECRET when set (signs source=marketing)
METADATA_HMAC_SECRET=

# Production: copy .env.production.example or run deploy/install.sh
