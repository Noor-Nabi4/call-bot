# Server-side LiveKit credentials (never expose to the browser)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match voice-agent rtc_session agent_name
AGENT_NAME=voice-agent

# Optional single-tenant id until multi-tenant dispatch exists
TENANT_ID=tenant_demo_acme

# HMAC secret shared with platform + voice-agent (signs agent dispatch metadata)
METADATA_HMAC_SECRET=

# Browser-visible platform API for telephony wizard
NEXT_PUBLIC_PLATFORM_API_URL=http://127.0.0.1:8000
