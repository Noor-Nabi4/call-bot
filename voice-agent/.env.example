LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# Optional agent configuration
BUSINESS_NAME=Acme HVAC
# Optional single-tenant id until multi-tenant dispatch (Phase 2–3)
TENANT_ID=tenant_demo_acme

# Versioned business facts the agent may speak (leave blank if unknown)
BUSINESS_HOURS=Monday to Friday, 8 AM to 6 PM
BUSINESS_SERVICE_AREA=Metro area and surrounding suburbs
BUSINESS_PHONE=
BUSINESS_ADDRESS=
BUSINESS_SERVICES=Heating, cooling, and emergency HVAC repair
BUSINESS_EXTRA_FACTS=

AGENT_NAME=voice-agent
AGENT_LANGUAGE=en
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
OPENAI_TEMPERATURE=0.8
USER_AWAY_TIMEOUT_SEC=15
MAX_CALL_DURATION_SEC=900
INACTIVITY_CHECK_LIMIT=2
INACTIVITY_CHECK_INTERVAL_SEC=10
MAX_SPOKEN_SENTENCES=2

# Phase 2 telephony / tenant resolution
PLATFORM_API_URL=http://127.0.0.1:8000
INTERNAL_SERVICE_TOKEN=
METADATA_HMAC_SECRET=
# Browser-only fallback when platform/metadata unavailable (never used for SIP)
ALLOW_ENV_TENANT_FALLBACK=
# production (default) | console — console may allow TENANT_ID fallback for browser-only
VOICE_RUNTIME_MODE=production
# Agent profile fetch (required after tenant resolve; no env business fallback)
AGENT_PROFILE_TIMEOUT_SEC=5
AGENT_PROFILE_CACHE_TTL_SEC=60

# Legacy local/console business facts (NOT used after tenant resolve; production never uses these)
# Production calls load GET /internal/tenants/{id}/agent-profile instead.
