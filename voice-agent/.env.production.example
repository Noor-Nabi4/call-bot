# Prefer: sudo bash deploy/install.sh  (writes a filled .env.production)

# Required when the agent runs on YOUR server (self-host worker).
# Not needed for LiveKit Cloud managed agents (Cloud injects LIVEKIT_*).
LIVEKIT_URL=wss://YOUR-LIVEKIT-HOST
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

OPENAI_API_KEY=
PLATFORM_API_URL=https://api.callandflow.com
INTERNAL_SERVICE_TOKEN=
METADATA_HMAC_SECRET=
ALLOW_ENV_TENANT_FALLBACK=false
VOICE_RUNTIME_MODE=production
AGENT_NAME=voice-agent
AGENT_LANGUAGE=en
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=marin
OPENAI_TEMPERATURE=0.8
USER_AWAY_TIMEOUT_SEC=15
MAX_CALL_DURATION_SEC=900
INACTIVITY_CHECK_LIMIT=2
INACTIVITY_CHECK_INTERVAL_SEC=10
MAX_SPOKEN_SENTENCES=2
AGENT_PROFILE_TIMEOUT_SEC=5
AGENT_PROFILE_CACHE_TTL_SEC=60
REDIS_URL=redis://redis:6379/0
