# Copy to deploy/answers.env before running install.sh for Call & Flow defaults.
# Secrets are NOT stored here — the installer will prompt (or auto-generate).

LIVEKIT_MODE_CHOICE=2
WEB_DOMAIN=callandflow.com
API_DOMAIN=api.callandflow.com
LIVEKIT_DOMAIN=livekit.callandflow.com
AGENT_NAME=voice-agent

# Host Postgres + Redis (not Docker)
SETUP_HOST_SERVICES=y
PG_DB=call_bot
PG_USER=callbot
PG_PORT=5432
REDIS_PORT=6379
REDIS_HOST_FOR_CONTAINERS=host.docker.internal

INSTALL_NGINX=y
INSTALL_CERTBOT=y
START_STACK=y
CERTBOT_EMAIL=admin@callandflow.com
