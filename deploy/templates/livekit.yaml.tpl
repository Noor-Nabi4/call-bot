# Self-hosted LiveKit SFU config — generated by deploy/install.sh
port: 7880
bind_addresses:
  - ""

rtc:
  tcp_port: 7881
  # Keep in sync with docker-compose.selfhost.yml UDP publish range
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true

redis:
  address: redis:6379

keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}

logging:
  level: info
