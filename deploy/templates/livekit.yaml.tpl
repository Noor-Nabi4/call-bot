# Self-hosted LiveKit SFU config — generated by deploy/install.sh
# Redis runs on the host; Docker reaches it via host.docker.internal
port: 7880
bind_addresses:
  - ""

rtc:
  tcp_port: 7881
  # Keep in sync with docker-compose.selfhost.yml UDP publish range
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true

redis:
  address: ${REDIS_HOST_FOR_CONTAINERS}:${REDIS_PORT}
  # LiveKit config-sample.yaml: redis.password (required when Redis has requirepass)
  password: "${REDIS_PASSWORD}"

keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}

logging:
  level: info
