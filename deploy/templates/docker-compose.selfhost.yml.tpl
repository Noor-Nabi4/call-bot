# Generated by deploy/install.sh — app containers only
# Postgres + Redis run on the HOST (systemd), not in Docker.
# Containers reach them via host.docker.internal (extra_hosts below).
# Web: ${WEB_DOMAIN}  API: ${API_DOMAIN}  LiveKit: ${LIVEKIT_MODE}

services:
${LIVEKIT_SERVICE_BLOCK}

  platform:
    build:
      context: ./platform
    image: voxpilot-platform:prod
    restart: unless-stopped
    env_file:
      - ./platform/.env.production
    environment:
      ENVIRONMENT: production
      COOKIE_SECURE: "true"
      ALLOW_ENV_TENANT_FALLBACK: "false"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "8000:8000"
    healthcheck:
      test:
        [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)",
        ]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 60s
    networks:
      - voxpilot

  web:
    build:
      context: ./web
      args:
        NEXT_PUBLIC_SITE_URL: https://${WEB_DOMAIN}
        NEXT_PUBLIC_PLATFORM_API_URL: https://${API_DOMAIN}
    image: voxpilot-web:prod
    restart: unless-stopped
    env_file:
      - ./web/.env.production
    environment:
      NODE_ENV: production
      NEXT_PUBLIC_SITE_URL: https://${WEB_DOMAIN}
      NEXT_PUBLIC_PLATFORM_API_URL: https://${API_DOMAIN}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "3000:3000"
    depends_on:
      platform:
        condition: service_healthy
    networks:
      - voxpilot

  voice-agent:
    build:
      context: ./voice-agent
    image: voxpilot-agent:prod
    restart: unless-stopped
    env_file:
      - ./voice-agent/.env.production
    environment:
      PYTHONUNBUFFERED: "1"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - platform
${AGENT_LIVEKIT_DEPENDS}
    # Outbound only — no published ports
    networks:
      - voxpilot

networks:
  voxpilot:
    driver: bridge
